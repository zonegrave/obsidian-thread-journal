{
	"name": "thread-journal",
	"version": "0.24.1",
	"description": "Thread trees with free-form workspaces and structured checkpoints for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild tests/core.test.ts --bundle --platform=node --format=esm --outfile=/tmp/thread-journal-core-test.mjs && node --test /tmp/thread-journal-core-test.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"author": "zonegrave",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "https://github.com/zonegrave/obsidian-thread-journal.git"
	},
	"bugs": {
		"url": "https://github.com/zonegrave/obsidian-thread-journal/issues"
	},
	"homepage": "https://github.com/zonegrave/obsidian-thread-journal#readme",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
